# Dedicated API service for Laras chatbot. Runs separately from your main backend.
PORT=8090
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Dashboard > Project Settings > Database > Connection string (URI).
# Keep this secret in the backend only. Use SSL and URL-encode special characters.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# RAGFlow is running locally via Docker Desktop and its web port is published on localhost:80.
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_API_KEY=REPLACE_WITH_RAGFLOW_API_KEY
RAGFLOW_CHAT_ID=REPLACE_WITH_LARAS_CHAT_ID
RAGFLOW_TIMEOUT_SECONDS=180
